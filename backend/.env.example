# Exemplo de variáveis de ambiente (copie para .env e ajuste)
# NÃO COMITE o arquivo .env com credenciais reais.

# Porta onde a API vai rodar
PORT=3000

# Configuração do Postgres (quando app roda no host e o container expõe a porta)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=jobsdb

# Connection string para Sequelize / sequelize-cli
# - se a app roda no host e você mapeou 5432 para localhost: use localhost
# - se a app roda dentro do mesmo docker-compose: use host 'db'
DATABASE_URL=postgres://postgres:postgres_password@localhost:5432/jobsdb